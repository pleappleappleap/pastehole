#!/bin/sh
# Drop-in pbcopy replacement for the remote server. Writes stdin to the
# reverse tunnel socket forwarded back to the Mac clipboard.
# Usage: pbcopy [-s SIZE] [user@hostname | hostname]

case "${1:-}" in
    -h|--help)
        printf 'usage: pbcopy [-s SIZE] [user@hostname | hostname]\n\nPipe stdin to the macOS clipboard via a pastehole reverse tunnel.\n\n  -s SIZE   truncate input to SIZE before sending (e.g. 100m, 2g)\n  hostname  target Mac hostname when multiple Macs are connected\n'
        exit 0 ;;
esac

_limit="100m"
if [ "${1:-}" = "-s" ]; then
    _limit=$(printf '%s' "${2:-}" | tr '[:upper:]' '[:lower:]')
    [ -z "$_limit" ] && { printf 'pbcopy: -s requires a size argument\n' >&2; exit 7; }
    printf '%s' "$_limit" | grep -qE '^[0-9]+[kmg]?$' || {
        printf 'pbcopy: invalid size: %s\n' "$_limit" >&2; exit 20; }
    shift 2
fi

_me=$(id -un)
_sockets=$(find /tmp -maxdepth 1 -name 'pbcopy-*.sock' -user "$_me" 2>/dev/null)
_count=$(printf '%s\n' "$_sockets" | grep -c '/tmp/')

if [ "$_count" -eq 0 ]; then
    printf 'pbcopy: no tunnel socket found; is pastehole running on your Mac?\n' >&2
    exit 8
elif [ "$_count" -eq 1 ]; then
    SOCKET="$_sockets"
elif [ -n "${1:-}" ]; then
    # Accept user@host or bare host. Dots escaped for regex. Match either:
    #   new format: pbcopy-USER@HOST-HEXTOKEN.sock  (or HOST as leftmost FQDN label)
    #   old format: pbcopy-HOST-HEXTOKEN.sock (bare host makes user field optional)
    case "$1" in
        *@*) _user="${1%%@*}"; _hostarg="${1#*@}" ;;
        *)   _user="";          _hostarg="$1" ;;
    esac
    _upat=$(printf '%s' "$_user"    | sed 's/\./\\./g')
    _hpat=$(printf '%s' "$_hostarg" | sed 's/\./\\./g')
    if [ -n "$_user" ]; then
        _re="/pbcopy-${_upat}@${_hpat}(-[0-9a-f]{32}\.sock|\..*-[0-9a-f]{32}\.sock)$"
    else
        _re="/pbcopy-([^/@]*@)?${_hpat}(-[0-9a-f]{32}\.sock|\..*-[0-9a-f]{32}\.sock)$"
    fi
    _match=$(printf '%s\n' "$_sockets" | grep -E "$_re")
    _nmatches=$(printf '%s\n' "$_match" | grep -c '/tmp/')
    if [ "$_nmatches" -eq 0 ]; then
        printf 'pbcopy: no tunnel socket for Mac "%s"\n' "$1" >&2; exit 9
    elif [ "$_nmatches" -gt 1 ]; then
        printf 'pbcopy: "%s" is ambiguous; be more specific:\n' "$1" >&2
        printf '%s\n' "$_match" \
            | sed 's|.*/pbcopy-||; s|-[0-9a-f]*\.sock$||' \
            | while IFS= read -r _h; do printf '  pbcopy %s\n' "$_h" >&2; done
        exit 10
    fi
    SOCKET="$_match"
else
    printf 'pbcopy: multiple Macs connected; specify a hostname:\n' >&2
    printf '%s\n' "$_sockets" \
        | sed 's|.*/pbcopy-||; s|-[0-9a-f]*\.sock$||' \
        | while IFS= read -r _h; do printf '  pbcopy %s\n' "$_h" >&2; done
    exit 11
fi

[ -S "$SOCKET" ] || { printf 'pbcopy: tunnel socket not found: %s\n' "$SOCKET" >&2; exit 12; }
head -c "$_limit" | socat - UNIX-CONNECT:"$SOCKET"
