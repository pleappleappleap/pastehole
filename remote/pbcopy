#!/bin/sh
# Drop-in pbcopy replacement for the remote server. Writes stdin to the
# reverse tunnel socket forwarded back to the Mac clipboard.
# Usage: pbcopy [-s SIZE] [mac-hostname]

_limit="100m"
if [ "${1:-}" = "-s" ]; then
    _limit=$(printf '%s' "${2:-}" | tr 'A-Z' 'a-z')
    [ -z "$_limit" ] && { printf 'pbcopy: -s requires a size argument\n' >&2; exit 7; }
    shift 2
fi

_me=$(id -un)
_sockets=$(find /tmp -maxdepth 1 -name 'pbcopy-*.sock' -user "$_me" 2>/dev/null)
_count=$(printf '%s\n' "$_sockets" | grep -c '/tmp/')

if [ "$_count" -eq 0 ]; then
    printf 'pbcopy: no tunnel socket found; is pastehole running on your Mac?\n' >&2
    exit 8
elif [ "$_count" -eq 1 ]; then
    SOCKET="$_sockets"
elif [ -n "${1:-}" ]; then
    # Escape dots in the given name, then match either:
    #   exact hostname:  pbcopy-NAME-HEXTOKEN.sock
    #   leftmost label:  pbcopy-NAME.domain-HEXTOKEN.sock
    _pat=$(printf '%s' "$1" | sed 's/\./\\./g')
    _match=$(printf '%s\n' "$_sockets" \
        | grep -E "/pbcopy-${_pat}(-[0-9a-f]{32}\.sock|\..*-[0-9a-f]{32}\.sock)$")
    _nmatches=$(printf '%s\n' "$_match" | grep -c '/tmp/')
    if [ "$_nmatches" -eq 0 ]; then
        printf 'pbcopy: no tunnel socket for Mac "%s"\n' "$1" >&2; exit 9
    elif [ "$_nmatches" -gt 1 ]; then
        printf 'pbcopy: "%s" is ambiguous; be more specific:\n' "$1" >&2
        printf '%s\n' "$_match" \
            | sed 's|.*/pbcopy-||; s|-[0-9a-f]*\.sock$||' \
            | while IFS= read -r _h; do printf '  pbcopy %s\n' "$_h" >&2; done
        exit 10
    fi
    SOCKET="$_match"
else
    printf 'pbcopy: multiple Macs connected; specify a hostname:\n' >&2
    printf '%s\n' "$_sockets" \
        | sed 's|.*/pbcopy-||; s|-[0-9a-f]*\.sock$||' \
        | while IFS= read -r _h; do printf '  pbcopy %s\n' "$_h" >&2; done
    exit 11
fi

[ -S "$SOCKET" ] || { printf 'pbcopy: tunnel socket not found: %s\n' "$SOCKET" >&2; exit 12; }
head -c "$_limit" | socat - UNIX-CONNECT:"$SOCKET"
