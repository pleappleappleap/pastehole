#!/bin/sh
# Mac-side tunnel dispatcher. Invoked by socat for each incoming connection.
# If the first 16 bytes match the session token, signals the monitor (probe).
# Otherwise passes stdin through to pbcopy unchanged (real clipboard traffic).
SESSION_TOKEN="$1"   # 16 random bytes as 32 hex chars
MONITOR_PID="$2"

prefix=$(head -c 16 | xxd -p | tr -d '\n')
if [ "$prefix" = "$SESSION_TOKEN" ]; then
    kill -USR1 "$MONITOR_PID"
else
    { printf '%s' "$prefix" | xxd -r -p; cat; } | pbcopy
fi
